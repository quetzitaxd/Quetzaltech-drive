# NODE_ENV lo establece Docker en producción; no fijarlo aquí para el build Vite.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
PUBLIC_URL=http://localhost:5173
# URL pública incorporada al compilar web/dist. Vacía para web del mismo origen.
# Para APK: URL HTTPS de la API, luego android:sync. Nunca poner secretos aquí.
VITE_API_BASE_URL=
# Propuesta inicial: 512 MiB por archivo, ajustar antes de despliegue.
MAX_FILE_BYTES=536870912
# Alta/cambio de contraseña: npm run account:setup (hash en SQLite, sin secreto aquí).
SESSION_TTL_SECONDS=86400
PAIRING_TTL_SECONDS=300
# Etapa 07: lista separada por comas de orígenes exactos de la APK (vacía por defecto).
ANDROID_ORIGINS=
