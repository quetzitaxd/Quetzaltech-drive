{
  "name": "quetzaltech-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "account:setup": "node scripts/account-setup.mjs",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "test:compiled": "node --test scripts/compiled.test.mjs",
    "test:restore": "node --test scripts/restore.test.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:compiled && npm run test:restore",
    "android:add": "npm run build -w web && cap add android",
    "android:sync": "npm run build -w web && cap sync android",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@capacitor/cli": "8.5.2"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2"
  }
}
